[package]
name = "kwantumkluis"
version = "0.5.0"
edition = "2021"
authors = ["Your Name"]
description = "Quantum-resistant air-gapped cryptocurrency vault in Rust - Hybrid PQC + Forward Security"
license = "MIT"
repository = "https://github.com/anoadder-ship-it/kwantumkluis1-"

[dependencies]
bip39 = "2.0"
ed25519-dalek = { version = "2", features = ["rand_core", "zeroize"] }
sha3 = "0.10"
rand = "0.8"
zeroize = { version = "1.8", features = ["derive"] }
hex = "0.4"
bs58 = "0.5"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
base64 = "0.22"
thiserror = "2.0"
ciborium = "0.2"
